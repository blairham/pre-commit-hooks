{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(pre-commit run:*)",
      "Bash(pre-commit try-repo:*)"
    ]
  }
}
